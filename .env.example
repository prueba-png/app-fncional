# Puerto del servidor local de Ganx (API + app compilada en producción)
DEVSTUDIO_PORT=8787

# Clave de la API de Anthropic (opcional). Si se define aquí, no hace falta
# introducirla en el panel de Ajustes. La clave del panel tiene prioridad.
ANTHROPIC_API_KEY=

# Permite ingerir URLs que resuelven a redes privadas / localhost
# (útil para estudiar tus propios servidores de desarrollo). Por defecto: false
ALLOW_PRIVATE_URLS=false

# URL de la Bot API de Telegram. Cámbiala solo si usas tu propio servidor
# Bot API (https://github.com/tdlib/telegram-bot-api), que eleva los límites de tamaño.
TELEGRAM_API_URL=https://api.telegram.org

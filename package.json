{
  "name": "devstudio-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Entorno de desarrollo local para análisis estructural de UI, prototipado rápido y respaldo descentralizado vía Telegram.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "build:demo": "cross-env VITE_DEMO=1 vite build --outDir dist-demo --emptyOutDir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@uiw/react-codemirror": "^4.25.12",
    "cheerio": "^1.2.0",
    "cross-env": "^10.1.0",
    "diff": "^9.0.0",
    "domhandler": "^6.0.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "idb": "^8.0.3",
    "jszip": "^3.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
